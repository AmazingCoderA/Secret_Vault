{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Secret Vault",
  "version": "0.1.2",
  "identifier": "app.local.vaultcalculator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
       "title": "Calculator",
      "width": 1120,
      "height": 780,
      "minWidth": 360,
      "minHeight": 600,
      "backgroundColor": "#101716",
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'self' blob:; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
